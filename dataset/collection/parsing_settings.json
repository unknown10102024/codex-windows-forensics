  "input_contract": [
    "Use copied artifact bytes and fresh output directories.",
    "Keep hive transaction-log companions with their matching hive working copy.",
    "Supply USN -m only for the matching source-volume MFT; do not substitute another volume.",
    "Supply SRUM -r only for the matching source-volume SOFTWARE hive; keep original database/log companions.",
    "Use NativeRegistry.reb for --bn.",
    "Collected PCA text, package startup-profile data, package manifests, Defender Store/MPLog, search databases and runtime binaries require their own handling; collection is not decoding."
  ],
  "limitations": [
    "Recorded parser success is not a completeness guarantee. Preserve PARSED_WITH_ERRORS and NO_OUTPUT_REVIEW_LOG.",
    "No executable is bundled. These settings do not include event-map packages or a full host-analysis engine.",
    "The two supplementary targets extend, rather than replace, baseline filesystem/event-log/Registry/execution collection."
  ]
